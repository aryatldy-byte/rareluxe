# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-api-key-here

# Note: These are PUBLIC keys (they're safe to expose in client code)
# Never share your SERVICE_ROLE_KEY in frontend code

# Optional: email of the view-only demo login (no add/edit/delete)
VITE_DEMO_EMAIL=demo@rareluxe.com

# Comma-separated login emails allowed to see Collected/Pending on the dashboard
VITE_COLLECTION_VIEWER_EMAILS=ashna@rareluxe.com
